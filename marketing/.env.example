# Leave blank for the MVP's honest 'registration opening soon' state.
# POST JSON { "email": "person@example.com" }; return 2xx only after persistence.
# This public endpoint must support browser CORS and server-side validation/rate limiting.
VITE_WAITLIST_ENDPOINT=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
# May be an approved contact page or mailto: URL.
VITE_CONTACT_URL=

# Public HTTPS origin. Build regenerates canonical, OG URLs, robots and sitemap.
# Optional on Vercel, which supplies the project's production domain; required
# for a build anywhere else.
SITE_URL=

# Optional: the exact unique HTTPS script URL from your Plausible installation snippet.
# No account or URL = no tracking. Disabled in development and with DNT/GPC enabled.
VITE_PLAUSIBLE_SCRIPT_URL=
